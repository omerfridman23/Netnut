# Backend environment configuration.
#
# For `docker compose up` you do NOT need this file — Compose injects these values
# (see docker-compose.yml). Copy it only for LOCAL development without Docker:
#
#   cp .env.example .env
#
# Every variable below has a sensible default in src/config/env.ts; the values
# here are the local-development defaults.

# SQLite database location. connection_limit=1 keeps a single connection per
# process so our PRAGMA settings (WAL / busy_timeout) reliably apply to every query.
DATABASE_URL="file:./dev.db?connection_limit=1"

# HTTP port the NestJS server listens on.
PORT=3000

# Node environment: "development" or "production".
NODE_ENV=development

# --- SQLite contention tuning (safe to leave at defaults) ---------------------

# How long (ms) a writer waits for the SQLite lock before surfacing SQLITE_BUSY.
BUSY_TIMEOUT_MS=5000

# How long (ms) Prisma waits to acquire the connection, and the max duration a
# single consume transaction may run. With connection_limit=1 these act as the
# queue-wait and max-transaction-time under bursts.
TX_MAX_WAIT_MS=20000
TX_TIMEOUT_MS=20000

# Retry policy for transient write contention (full-jitter exponential backoff).
DB_RETRIES=5
DB_RETRY_BASE_DELAY_MS=25
DB_RETRY_MAX_DELAY_MS=1000

# --- Security ----------------------------------------------------------------

# Comma-separated list of allowed CORS origins, e.g. "https://app.example.com".
# Leave empty in development (allows any origin); set the exact origin in production.
CORS_ORIGINS=
